# Secrets and local configuration
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
dist/
build/
*.egg-info/

# Node / Next.js
node_modules/
dashboard/node_modules/
dashboard/.next/
dashboard/out/
dashboard/.vercel/
dashboard/test-results/
