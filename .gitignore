# Runtime data; committed fixtures are intentionally separate
data/raw/*
!data/raw/.gitkeep
data/artifacts/*
!data/artifacts/.gitkeep
data/backups/*
!data/backups/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/*.db
data/derived/
logs/

# dbt
warehouse/target/
warehouse/logs/
warehouse/dbt_packages/
warehouse/.user.yml

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Disposable verification scratch (restore copies, backups); never committed
data/*-verify-temp/
.claude/settings.local.json
