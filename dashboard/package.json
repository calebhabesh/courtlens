  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "^16.4.0",
    "happy-dom": "20.14.5",
    "stylelint": "^17.16.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  }
