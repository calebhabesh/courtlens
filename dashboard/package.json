  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "16.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.5",
    "happy-dom": "17.4.2",
    "stylelint": "^17.16.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
