{
  "name": "courtlens-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fonts:ensure": "node scripts/ensure-local-fonts.mjs",
    "postinstall": "npm run fonts:ensure",
    "predev": "npm run fonts:ensure",
    "prebuild": "npm run fonts:ensure",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && stylelint '**/*.css'",
    "lint:eslint": "eslint .",
    "lint:css": "stylelint '**/*.css'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:real": "PLAYWRIGHT_EXTERNAL_SERVER=true playwright test"
  },
  "dependencies": {
    "d3-hierarchy": "3.1.2",
    "d3-sankey": "0.12.3",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "^16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-sankey": "0.12.5",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.2",
    "happy-dom": "20.14.6",
    "stylelint": "^17.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  }
}
