{
  "rules": {
    "color-no-hex": [true, { "severity": "error" }],
    "color-named": ["never", { "severity": "error" }],
    "function-disallowed-list": [["rgb", "rgba", "hsl", "hsla"], { "severity": "error" }],
    "declaration-property-value-disallowed-list": [
      {
        "/^(padding|margin|gap|border-radius|font-size|line-height)/": [
          "/(?:\\b0\\.\\d+px|\\b(?:[02-9]|[1-9]\\d+)(?:\\.\\d+)?px|[0-9]+(?:\\.[0-9]+)?rem)/"
        ],
        "z-index": ["/(?<![0-9])[1-9][0-9]*/"],
        "/^transition/": ["/\\ball\\b/"],
        "transition-duration": ["/[0-9]+(?:s|ms)/"]
      },
      { "severity": "error" }
    ],
    "declaration-no-important": [true, { "severity": "error" }],
    "selector-disallowed-list": [
      [
        "/\\.ui-(?:button|icon-button|select|segmented|menu-trigger|popover-trigger|date-trigger|tab-trigger|entity-chip|chip|filter-bar-toggle|why-summary)(?![a-z0-9])/",
        "/\\[data-kit\\b/"
      ],
      {
        "severity": "error",
        "message": "Page and feature CSS may not select control kit classes. Place the control with a wrapper class and set its look with size, variant and tone props (UC03, docs/design/control-kit-v1.md)."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/tokens.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "declaration-property-value-disallowed-list": null
      }
    },
    {
      "files": ["**/motion.css"],
      "rules": {
        "declaration-no-important": null
      }
    },
    {
      "files": [
        "app/styles/components.css",
        "app/styles/foundation.css",
        "app/styles/pages.css",
        "app/styles/presentation-clarity.css",
        "app/styles/table-presentation.css",
        "components/stats-explorer.css"
      ],
      "rules": {
        "selector-disallowed-list": null
      }
    }
  ]
}
