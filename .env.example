# Runtime
COURTLOAD_ENVIRONMENT=development
COURTLOAD_DATABASE_URL=postgresql+psycopg://courtload:courtload@localhost:5432/courtload
COURTLOAD_JWT_SECRET=replace-with-at-least-32-random-characters
COURTLOAD_ACCESS_TOKEN_MINUTES=720
COURTLOAD_CORS_ORIGINS=["http://localhost:3000"]
COURTLOAD_LOG_LEVEL=INFO

# Provider. Create a key at https://app.balldontlie.io.
# Teams/players/games are on Free. Game-player stats require NBA ALL-STAR or higher.
BALLDONTLIE_API_KEY=
COURTLOAD_BDL_BASE_URL=https://api.balldontlie.io/v1
COURTLOAD_BDL_REQUESTS_PER_MINUTE=5
COURTLOAD_RAW_STORE_PATH=./data/raw

# Dashboard (server-side URL is used by Next.js; browser URL is public).
COURTLOAD_API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_COURTLOAD_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
COURTLOAD_DASHBOARD_PORT=3000

# Optional failure webhook used by scripts/refresh.sh (ntfy-compatible URL).
COURTLOAD_FAILURE_WEBHOOK_URL=
