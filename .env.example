# Runtime
COURTLOAD_ENVIRONMENT=development
COURTLOAD_DATABASE_URL=postgresql+psycopg://courtload:courtload@localhost:5432/courtload
COURTLOAD_JWT_SECRET=replace-with-at-least-32-random-characters
COURTLOAD_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
COURTLOAD_ACCESS_TOKEN_MINUTES=720
COURTLOAD_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
COURTLOAD_LOG_LEVEL=INFO

# Storage and Artifacts
COURTLOAD_RAW_STORE_PATH=./data/raw
COURTLOAD_ARTIFACTS_ROOT=./data/artifacts
COURTLOAD_PORTRAITS_CACHE_PATH=./data/cache/portraits

# Worker and Refresh Schedule (UTC daily window)
COURTLOAD_WORKER_REFRESH_TIME_UTC=09:00

# Provider. Create a key at https://app.balldontlie.io.
# Teams/players/games are on Free. Game-player stats require NBA ALL-STAR or higher.
BALLDONTLIE_API_KEY=
COURTLOAD_BDL_BASE_URL=https://api.balldontlie.io/v1
COURTLOAD_BDL_REQUESTS_PER_MINUTE=5
DBT_SCHEMA=analytics

# Dashboard (server-side URL is used by Next.js; browser URL is public).
COURTLOAD_API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_COURTLOAD_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
COURTLOAD_DASHBOARD_PORT=3000

# Optional failure webhook used by scripts/refresh.sh (ntfy-compatible URL).
COURTLOAD_FAILURE_WEBHOOK_URL=

# Optional Gemini AI Assistant (Milestone P8)
# Zero-cost core guarantee: CourtLoad requires no paid subscription or API key for complete operation.
# Provide a key to enable optional natural language assistance over verified read-only analytical tools.
COURTLOAD_GEMINI_API_KEY=
# Use an eligible free-tier project. The alias can change models; evaluation records its version.
COURTLOAD_GEMINI_MODEL=gemini-3.5-flash-lite

# B31 opt-in consumer-source Live acquisition; cached GETs never fetch.
# Real in-game freshness remains unobserved until recorded separately.
COURTLOAD_LIVE_ENABLED=false
