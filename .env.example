# Runtime
COURTLENS_ENVIRONMENT=development
# Local Compose database password; update the URL below if changed.
COURTLENS_POSTGRES_PASSWORD=courtlens
COURTLENS_DATABASE_URL=postgresql+psycopg://courtlens:courtlens@localhost:5432/courtlens
# PostgreSQL tests require a separate disposable instance, never the owner's database.
# COURTLENS_TEST_POSTGRES_URL=postgresql+psycopg://courtlens:courtlens@localhost:55432/courtlens
# If pg_dump/psql are not installed locally, identify that disposable container explicitly.
# COURTLENS_TEST_POSTGRES_CONTAINER=courtlens-postgres-test
COURTLENS_JWT_SECRET=replace-with-at-least-32-random-characters
COURTLENS_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
COURTLENS_ACCESS_TOKEN_MINUTES=720
COURTLENS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
COURTLENS_LOG_LEVEL=INFO

# Storage and Artifacts
COURTLENS_RAW_STORE_PATH=./data/raw
COURTLENS_ARTIFACTS_ROOT=./data/artifacts
COURTLENS_PORTRAITS_CACHE_PATH=./data/cache/portraits

# Worker and Refresh Schedule (UTC daily window)
COURTLENS_WORKER_REFRESH_TIME_UTC=09:00

# Provider. Create a key at https://app.balldontlie.io.
# Teams/players/games are on Free. Game-player stats require NBA ALL-STAR or higher.
BALLDONTLIE_API_KEY=
COURTLENS_BDL_BASE_URL=https://api.balldontlie.io/v1
COURTLENS_BDL_REQUESTS_PER_MINUTE=5
DBT_SCHEMA=analytics

# Dashboard (server-side URL is used by Next.js; browser URL is public).
COURTLENS_API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_COURTLENS_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
COURTLENS_DASHBOARD_PORT=3000

# Optional failure webhook used by scripts/refresh.sh (ntfy-compatible URL).
COURTLENS_FAILURE_WEBHOOK_URL=

# Optional assistant providers (AG01). Keys are server-only; never use NEXT_PUBLIC_*.
# Zero-cost core guarantee: CourtLens requires no paid subscription or API key for complete operation.
# Provider precedence when unset: Gemini, Anthropic, OpenAI, then limited mode.
# Set to none to force limited mode. Never falls back to a different paid provider automatically.
COURTLENS_ASSISTANT_PROVIDER=
COURTLENS_ASSISTANT_MODEL=
COURTLENS_GEMINI_API_KEY=
# Native search may require billing eligibility. Account quotas still apply.
# Also accepts GEMINI_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY.
COURTLENS_ANTHROPIC_API_KEY=
COURTLENS_OPENAI_API_KEY=
# Defaults: gemini-3.8-flash / claude-sonnet-5-5 / gpt-6.1-sol.
# Legacy COURTLENS_GEMINI_MODEL is a Gemini-only alias, below ASSISTANT_MODEL in precedence.
# COURTLENS_GEMINI_MODEL=gemini-3.8-flash
COURTLENS_ASSISTANT_MAX_STEPS=6
COURTLENS_ASSISTANT_MAX_WEB_SEARCHES=3
COURTLENS_ASSISTANT_MAX_TOKENS=60000
COURTLENS_ASSISTANT_TURN_TIMEOUT_SECONDS=60
COURTLENS_ASSISTANT_PRICES_FILE=config/assistant-prices.yaml

# B31 opt-in consumer-source Live acquisition; cached GETs never fetch.
# Real in-game freshness remains unobserved until recorded separately.
COURTLENS_LIVE_ENABLED=false
